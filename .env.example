# Supabase: URL del proyecto y llave publicable (Project Settings > API Keys)
NUXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# La misma clave que privado.claves (nombre = 'servidor'); la usa el servidor para confirmar pagos
NUXT_CLAVE_SERVIDOR=
# Stripe en modo de prueba (sk_test_...)
NUXT_STRIPE_SECRET_KEY=
